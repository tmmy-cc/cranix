{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/secure-systems-lab/dsse/v1/envelope.schema.json",
  "title": "DSSE envelope",
  "description": "A Dead Simple Signing Envelope, transcribed from https://github.com/secure-systems-lab/dsse/blob/master/envelope.md.",
  "type": "object",
  "required": ["payload", "payloadType", "signatures"],
  "properties": {
    "payload": { "type": "string", "contentEncoding": "base64" },
    "payloadType": { "type": "string", "minLength": 1 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sig"],
        "properties": {
          "keyid": { "type": "string" },
          "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
        }
      }
    }
  }
}
